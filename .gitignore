node_modules/
dist/

# gen-radio-voices working set: piper venv, voice model, intermediate wavs
tools/.cache/

# Fredrin: commit only the guidelines file; the wrapper carries a credential
.fredrin/*
!.fredrin/FREDRIN.md
# Claude Code's machine-local settings: never repo content (biome's VCS
# integration reads only this file, not .git/info/exclude)
.claude/settings.local.json

# tools/perf working files: `last.json` is the default --out scratch, and
# aa-comparison.html embeds every capture as base64 (the .png is committed).
tools/perf/last.json
tools/perf/aa-comparison.html
# the full uncropped frame is a debugging aid; the committed pair is the crop
tools/perf/aa-frame.png

# Claude Code: machine-local settings (the shared .claude/settings.json is
# committable); biome only reads .gitignore, not .git/info/exclude.
.claude/settings.local.json
